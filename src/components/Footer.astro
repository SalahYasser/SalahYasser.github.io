---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <p>© {year} {site.name} · {site.location}</p>
    <ul>
      <li><a href={site.links.github} rel="me noopener" target="_blank">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--faint); font-size: 0.9rem; }
  .row { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; } a:hover { color: var(--text); text-decoration: underline; }
</style>
