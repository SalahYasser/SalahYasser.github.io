---
import { site, copy } from '../data/site';
const f = copy.footer;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <p>© {year} {site.name} · {site.location}</p>
    <ul>
      <li><a href={site.links.github} rel="me noopener" target="_blank">{f.github}<span class="visually-hidden">{f.newTab}</span></a></li>
      <li><a href={site.links.linkedin} rel="me noopener" target="_blank">{f.linkedin}<span class="visually-hidden">{f.newTab}</span></a></li>
      <li><a href={`mailto:${site.email}`}>{f.email}</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--faint); font-size: 0.9rem; }
  .row { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--accent); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--accent-2); text-decoration: underline; }
</style>
