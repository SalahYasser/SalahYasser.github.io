---
import '@fontsource-variable/inter-tight';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import plexArabic400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import plexArabic600 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isPreview } from '../data/projects';
import { content, langFromPath, localeMeta, localePath, alternatePaths, defaultLang, langs, type Lang } from '../lib/i18n';

// `share` is a purpose-made 1200×630 share image with its alt text; pages without one use the default.
// `noindex` pages (404, redirects) get a robots noindex, no canonical/og:url and no JSON-LD.
// `jsonLd` adds page-specific schema.org nodes to the site-wide Person + WebSite graph.
interface Props {
  title?: string;
  description?: string;
  share?: { src: string; alt: string };
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
// The locale comes from the URL: pages under /ar/ are Arabic (RTL), everything else English.
const lang = langFromPath(Astro.url.pathname);
const meta = localeMeta[lang];
const { site, copy, experience, education, skills } = content(lang);
const { title, description = site.description, share = { src: site.shareImage, alt: copy.ogImageAlt }, ogType = 'website', noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(share.src, Astro.site);
// Indexable pages exist in both languages: hreflang alternates, and the header toggle links to the same page in the other language.
// noindex pages (404, redirects) have no counterpart, so the toggle goes to the other language's home page.
const alternates = alternatePaths(Astro.url.pathname);
const otherLang: Lang = lang === 'ar' ? 'en' : 'ar';
const toggleHref = noindex ? localePath(otherLang, '/') : alternates[otherLang];
const home = new URL(localePath(lang, '/'), Astro.site).href;
// One Person entity for both languages (same @id), described in the page's language.
const personId = `${new URL('/', Astro.site).href}#person`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      ...(lang !== defaultLang ? { alternateName: content(defaultLang).site.name } : {}),
      url: home,
      image: new URL(site.photo.src, Astro.site).href,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      address: { '@type': 'PostalAddress', addressLocality: site.locality, addressCountry: site.countryCode },
      sameAs: [site.links.github, site.links.linkedin],
      knowsAbout: skills.flatMap((g) => g.items),
      worksFor: experience.filter((e) => e.current).map((e) => ({ '@type': 'Organization', name: e.org })),
      alumniOf: education.filter((e) => e.degree).map((e) => ({ '@type': 'CollegeOrUniversity', name: e.org })),
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: site.name,
      description: site.description,
      inLanguage: meta.htmlLang,
      author: { '@id': personId },
    },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang={meta.htmlLang} dir={lang === 'ar' ? meta.dir : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'ar' && (
      <>
        <link rel="preload" href={plexArabic400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={plexArabic600} as="font" type="font/woff2" crossorigin />
      </>
    )}
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={new URL(alternates[l], Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], Astro.site)} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0f1c" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={localeMeta[otherLang].ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={share.alt} />
    {(isPreview || noindex) && <meta name="robots" content="noindex" />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // On a view-transition arrival, show morph targets (project cards) at once so they aren't captured mid-fade.
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.querySelectorAll('.reveal:has([style*="view-transition-name"])').forEach((el) => el.classList.add('is-in', 'vt-shown'));
      });
    </script>
    {import.meta.env.PROD && site.analytics.goatcounter && (
      <>
        <link rel="preconnect" href={new URL(site.analytics.goatcounter).origin} />
        <link rel="preconnect" href={new URL(site.analytics.script).origin} />
      </>
    )}
    {import.meta.env.PROD && site.analytics.goatcounter && (
      <script is:inline async data-goatcounter={site.analytics.goatcounter} src={site.analytics.script}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipToContent}</a>
    {isPreview && (
      <div class="preview-banner" role="note">{copy.previewBanner}</div>
    )}
    <Header toggleHref={toggleHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
