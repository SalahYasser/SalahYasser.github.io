---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>This page <span class="serif">isn’t here.</span></h1>
    <p>The link may be out of date.</p>
    <a class="btn btn-primary" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 60vh; display: grid; align-content: center; justify-items: start; gap: 1.25rem; padding-block: 5rem; }
  h1 { font-size: clamp(2.4rem, 7vw, 4.5rem); }
  p:not(.eyebrow) { color: var(--muted); }
</style>
