---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../data/site';
const n = copy.notFound;
---
<BaseLayout title={n.pageTitle} noindex>
  <section class="container nf">
    <p class="eyebrow">{n.eyebrow}</p>
    <h1>{n.titleBefore} <span class="serif">{n.titleSerif}</span></h1>
    <p>{n.body}</p>
    <a class="btn btn-primary" href="/">{n.cta}</a>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 60vh; display: grid; align-content: center; justify-items: start; gap: 1.25rem; padding-block: 5rem; }
  h1 { font-size: clamp(2.4rem, 7vw, 4.5rem); }
  p:not(.eyebrow) { color: var(--muted); }
</style>
