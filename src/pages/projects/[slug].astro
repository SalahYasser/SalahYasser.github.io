---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { caseStudies, isPreview, type Project } from '../../data/projects';
import { copy } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}
interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;
const s = p.sections!;
const hasNext = next.slug !== p.slug;
const t = copy.caseStudy;
const sec = t.sections;
---
<BaseLayout title={`${p.title} ${t.pageTitleSuffix}`} description={p.summary} share={p.ogImage ? { src: p.ogImage, alt: `${p.title} — ${p.tagline}` } : undefined} ogType="article">
  <article class="cs" style={`--pa:${p.accent.base};--pink:${p.accent.ink};--pglow:${p.accent.glow}`}>
    <header class="cs-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <a class="back" href="/#work"><span aria-hidden="true">←</span> {t.back}</a>
          <div class="title-row">
            {p.icon && <img class="app-icon" src={p.icon} alt={`${p.title} app icon`} width="256" height="256" />}
            <div>
              <p class="kicker">{p.kind} · {p.platform}</p>
              <h1>{p.title} {p.nativeTitle && <span class="native" lang="ar" dir="rtl">{p.nativeTitle}</span>}</h1>
            </div>
          </div>
          <p class="lede">{p.tagline}</p>
          {isPreview && p.approval === 'pending' && <p class="pending-note">{t.pendingPrefix} {p.approvalNote}</p>}
          <dl class="facts">
            <div><dt>{t.roleLabel}</dt><dd>{p.role}</dd></div>
            <div><dt>{t.statusLabel}</dt><dd>{p.status}</dd></div>
            <div class="wide"><dt>{t.stackLabel}</dt><dd><ul class="chips">{p.technologies.map((t) => <li class="chip">{t}</li>)}</ul></dd></div>
          </dl>
          {p.links.length > 0 && (
            <div class="links">
              {p.links.map((l) => (
                <a class="btn btn-primary btn-store" href={l.href} target="_blank" rel="noopener"><Icon name={l.icon ?? 'apple'} /> {l.label}<span class="visually-hidden">{t.newTab}</span></a>
              ))}
            </div>
          )}
        </div>
        <div class="hero-shots" aria-hidden="true">
          {p.screenshots.slice(0, 2).map((sh, i) => (
            <div class={`shot hs${i}`}><img src={sh.src} alt="" width="590" height="1280" fetchpriority={i === 0 ? 'high' : 'auto'} /></div>
          ))}
        </div>
      </div>
    </header>

    <div class="container body">
      <section class="block reveal" aria-labelledby="q1">
        <p class="q-num">{sec.product.num}</p>
        <div><h2 id="q1">{sec.product.title}</h2><p>{s.product}</p></div>
      </section>
      <section class="block reveal" aria-labelledby="q2">
        <p class="q-num">{sec.role.num}</p>
        <div><h2 id="q2">{sec.role.title}</h2><p>{s.roleDetail}</p></div>
      </section>
      <section class="block reveal" aria-labelledby="q3">
        <p class="q-num">{sec.problem.num}</p>
        <div><h2 id="q3">{sec.problem.title}</h2><p class="pull">{s.problem}</p></div>
      </section>
      <section class="block reveal" aria-labelledby="q4">
        <p class="q-num">{sec.decisions.num}</p>
        <div>
          <h2 id="q4">{sec.decisions.title}</h2>
          <ol class="decisions">
            {s.decisions.map((d) => (<li><h3>{d.title}</h3><p>{d.body}</p></li>))}
          </ol>
        </div>
      </section>
    </div>

    <section class="gallery-wrap reveal" aria-labelledby="q5">
      <div class="container gallery-head">
        <p class="q-num">{sec.built.num}</p>
        <div>
          <h2 id="q5">{sec.built.title}</h2>
          <ul class="implemented">{s.implemented.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      <div class="gallery" role="region" aria-label={`${p.title} ${t.galleryAriaSuffix}`} tabindex="0">
        <ul>
          {p.screenshots.map((sh, i) => (
            <li>
              <figure>
                <a class="shot zoom" href={sh.src} data-index={i} aria-label={`${t.enlargePrefix} ${sh.caption}`}>
                  <img src={sh.src} alt={sh.alt} width="590" height="1280" loading="lazy" decoding="async" />
                  <span class="zoom-ico" aria-hidden="true"><Icon name="expand" /></span>
                </a>
                <figcaption>{sh.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
      <p class="container src-note">{t.screenshotsNote}</p>
    </section>

    <div class="container body">
      <section class="block reveal" aria-labelledby="q6">
        <p class="q-num">{sec.result.num}</p>
        <div><h2 id="q6">{sec.result.title}</h2><p class="pull">{s.result}</p></div>
      </section>
      <section class="block reveal" aria-labelledby="q7">
        <p class="q-num">{sec.seeIt.num}</p>
        <div>
          <h2 id="q7">{sec.seeIt.title}</h2>
          <div class="links">
            {p.links.map((l) => (<a class="btn btn-primary btn-store" href={l.href} target="_blank" rel="noopener"><Icon name={l.icon ?? 'apple'} /> {l.label}<span class="visually-hidden">{t.newTab}</span></a>))}
            <a class="btn btn-ghost" href="/#contact">{t.askAboutIt}</a>
          </div>
        </div>
      </section>
    </div>

    {hasNext && (
      <nav class="container next reveal" aria-label={t.nextLabel}>
        <a href={`/projects/${next.slug}/`}>
          <span class="nl">{t.nextLabel}</span>
          <span class="nt">{next.title} <Icon name="arrow" /></span>
        </a>
      </nav>
    )}

    <dialog class="lightbox" aria-label={t.viewerLabel} tabindex="-1">
      <form method="dialog" class="lb-close-form"><button class="lb-btn close" aria-label={t.closeViewer}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button></form>
      <button class="lb-btn nav prev" type="button" aria-label={t.prevShot}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <figure class="lb-stage"><figcaption></figcaption></figure>
      <button class="lb-btn nav nextb" type="button" aria-label={t.nextShot}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    </dialog>
  </article>
</BaseLayout>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.zoom'));
  if (dlg && typeof dlg.showModal === 'function' && links.length) {
    const img = document.createElement('img');
    img.className = 'lb-img';
    img.decoding = 'async';
    dlg.querySelector('figure')!.prepend(img);
    const cap = dlg.querySelector('figcaption')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + links.length) % links.length;
      const a = links[idx];
      const im = a.querySelector('img')!;
      img.src = a.href; img.alt = im.alt;
      cap.textContent = a.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
    };
    // Keyboard opens keep focus on the close button (visible ring); pointer opens focus the dialog itself so no stray ring shows.
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); dlg.showModal(); if (e.detail > 0) dlg.focus(); }));
    dlg.querySelector('.prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.nextb')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(idx - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(idx + 1); }
    });
    // Clicking the dimmed area (the dialog itself, not the image, caption or buttons) closes the viewer.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    // Horizontal swipe on touch screens.
    let sx = 0, sy = 0;
    dlg.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(dx < 0 ? idx + 1 : idx - 1);
    }, { passive: true });
    dlg.addEventListener('close', () => links[idx]?.focus());
  }
</script>

<style>
  .cs-hero { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(2rem, 6vw, 4rem); position: relative; overflow: hidden;
    background: radial-gradient(50rem 30rem at 85% 30%, var(--pglow), transparent 65%); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.2fr 0.8fr; } }
  .hero-copy { display: grid; gap: 1.4rem; }
  .back { color: var(--accent); text-decoration: none; font-size: .95rem; width: fit-content; transition: color .2s; }
  .back:hover { color: var(--accent-2); text-decoration: underline; }
  .title-row { display: flex; gap: 1.25rem; align-items: center; }
  .app-icon { width: clamp(4rem, 9vw, 5.5rem); height: auto; border-radius: 22%; box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 16px 40px -12px var(--pglow); flex: none; }
  .kicker { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--pa); margin-bottom: .5rem; }
  h1 { font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -0.035em; display: flex; flex-wrap: wrap; align-items: baseline; gap: .1em .4em; }
  .native { font-size: .45em; color: var(--pa); font-weight: 600; }
  .lede { font-size: clamp(1.15rem, 2vw, 1.4rem); color: var(--text); max-width: 40rem; }
  .facts { display: grid; gap: 1px; margin: .4rem 0 0; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; }
  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr; } .facts .wide { grid-column: 1 / -1; } }
  .facts > div { background: var(--bg-2); padding: 1rem 1.1rem; }
  dt { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); margin-bottom: .35rem; }
  dd { margin: 0; color: var(--muted); font-size: .97rem; }
  .links { display: flex; flex-wrap: wrap; gap: .75rem; }
  /* Store buttons use the primary (site accent) style; project colour stays off clickable elements. */

  .hero-shots { position: relative; height: clamp(22rem, 50vw, 32rem); }
  .hero-shots .shot { position: absolute; width: clamp(9.5rem, 20vw, 14rem); top: 50%; left: 50%; }
  .hs0 { transform: translate(-85%, -52%) rotate(-4deg); z-index: 2; }
  .hs1 { transform: translate(-10%, -45%) rotate(4deg); z-index: 1; }
  @media (max-width: 959px) { .hero-shots { height: 20rem; } .hero-shots .shot { width: 9rem; } }

  .body { display: grid; gap: 0; max-width: 62rem; }
  .block { display: grid; gap: .5rem 2rem; padding-block: clamp(2.25rem, 5vw, 3.5rem); border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { .block { grid-template-columns: 5rem 1fr; } }
  .q-num { font-family: var(--font-mono); color: var(--pa); font-size: .9rem; padding-top: .35rem; }
  .block h2, .gallery-head h2 { font-size: clamp(1.6rem, 3.2vw, 2.2rem); margin-bottom: 1rem; }
  .block p { color: var(--muted); font-size: 1.1rem; max-width: 46rem; }
  .block .pull { color: var(--text); font-size: clamp(1.2rem, 2.2vw, 1.45rem); line-height: 1.5; letter-spacing: -0.01em; }
  .decisions { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; counter-reset: d; }
  @media (min-width: 760px) { .decisions { grid-template-columns: 1fr 1fr; } }
  .decisions li { counter-increment: d; padding: 1.4rem; border-radius: var(--radius-sm); border: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), var(--bg-2)); }
  .decisions h3 { font-size: 1.12rem; margin-bottom: .6rem; display: flex; gap: .6rem; align-items: baseline; }
  .decisions h3::before { content: counter(d, decimal-leading-zero); font-family: var(--font-mono); font-size: .75rem; color: var(--pa); font-weight: 500; }
  .decisions p { font-size: .98rem; }

  .gallery-wrap { padding-block: clamp(2.25rem, 5vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .gallery-head { display: grid; gap: .5rem 2rem; max-width: 62rem; }
  @media (min-width: 760px) { .gallery-head { grid-template-columns: 5rem 1fr; } }
  .implemented { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .55rem 1.5rem; color: var(--muted); }
  @media (min-width: 640px) { .implemented { grid-template-columns: 1fr 1fr; } }
  .implemented li { padding-left: 1.4rem; position: relative; }
  .implemented li::before { content: ''; position: absolute; left: 0; top: .55em; width: .55rem; height: .55rem; border-radius: 3px; background: var(--pa); opacity: .85; }
  .gallery { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-bottom: 1rem; }
  .gallery:focus-visible { outline-offset: -2px; }
  .gallery ul { list-style: none; margin: 0; display: flex; gap: 1.25rem; padding: .5rem max(1.25rem, calc((100vw - var(--max)) / 2)); width: max-content; }
  .gallery li { scroll-snap-align: center; width: clamp(12rem, 22vw, 16rem); }
  .gallery figure { margin: 0; display: grid; gap: .9rem; }
  .zoom { display: block; position: relative; }
  .zoom img { transition: transform .5s var(--ease); }
  .zoom:hover img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) { .zoom img { transition: none; } .zoom:hover img { transform: none; } }
  .zoom-ico { position: absolute; right: .7rem; top: .7rem; width: 2.1rem; height: 2.1rem; display: grid; place-items: center; border-radius: 50%; background: rgba(4,18,28,.72); color: var(--accent); border: 1px solid rgba(92,200,255,.45); opacity: 0; transition: opacity .25s; }
  .zoom-ico :global(svg) { width: 1rem; height: 1rem; }
  .zoom:hover .zoom-ico, .zoom:focus-visible .zoom-ico { opacity: 1; }
  figcaption { font-size: .9rem; color: var(--muted); line-height: 1.45; }
  .src-note { margin-top: .75rem; font-size: .8rem; color: var(--faint); font-family: var(--font-mono); }

  .next { padding-block: clamp(3rem, 7vw, 5rem); }
  .next a { display: grid; gap: .5rem; text-decoration: none; padding: clamp(1.75rem, 5vw, 3rem); border-radius: calc(var(--radius) + 6px); border: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), var(--bg-2)); transition: border-color .3s; }
  .next a:hover { border-color: rgba(92, 200, 255, 0.45); }
  .next a:hover .nt { color: var(--accent-2); }
  .nl { font-family: var(--font-mono); font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); }
  .nt { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 650; letter-spacing: -0.03em; display: inline-flex; align-items: center; gap: .4em; color: var(--accent); transition: color .2s; }
  .nt :global(svg) { width: .7em; height: .7em; transition: transform .3s var(--ease); }
  .next a:hover .nt :global(svg) { transform: translateX(6px); }
  @media (prefers-reduced-motion: reduce) { .next a:hover .nt :global(svg) { transform: none; } }

  /* Screenshot viewer. The <img> is created by script, so rules that target it use :global(). */
  .lightbox { --lb-pad: clamp(.75rem, 2vw, 1.5rem); --lb-btn: 3rem;
    position: fixed; inset: 0; margin: 0; border: 0; padding: var(--lb-pad); background: transparent; color: var(--text);
    width: 100vw; height: 100vh; height: 100dvh; max-width: 100vw; max-height: 100dvh; overflow: hidden; }
  .lightbox[open] { display: grid; grid-template-columns: var(--lb-btn) minmax(0, 1fr) var(--lb-btn); grid-template-rows: minmax(0, 1fr);
    grid-template-areas: 'prev stage next'; align-items: center; column-gap: var(--lb-pad); animation: lb-in .22s var(--ease) both; }
  .lightbox:focus { outline: none; }
  .lightbox::backdrop { background: rgba(4, 7, 14, .9); backdrop-filter: blur(6px); }
  .lb-close-form { display: contents; }
  .lb-stage { grid-area: stage; justify-self: center; margin: 0; display: flex; flex-direction: column; align-items: center; gap: .9rem; min-width: 0; }
  .lightbox :global(.lb-img) { display: block; width: auto; height: auto; max-width: min(90vw, 100%); max-height: calc(100dvh - 2 * var(--lb-pad) - 4.5rem);
    object-fit: contain; border-radius: clamp(14px, 1.6vw, 22px); box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 30px 80px -20px rgba(0,0,0,.7); background: var(--bg-2); }
  .lightbox figcaption { text-align: center; max-width: 34rem; padding-inline: .5rem; color: var(--muted); font-size: .95rem; line-height: 1.45; }
  .lb-btn { width: var(--lb-btn); height: var(--lb-btn); display: grid; place-items: center; padding: 0; margin: 0; border-radius: 50%;
    border: 1px solid rgba(92,200,255,.45); background: rgba(4,18,28,.72); color: var(--accent); cursor: pointer;
    transition: background .2s, color .2s, border-color .2s; }
  .lb-btn svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .lb-btn:hover { background: rgba(92,200,255,.14); color: var(--accent-2); border-color: var(--accent-2); }
  .lb-btn:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 3px; border-radius: 50%; }
  .lightbox .close { position: fixed; top: var(--lb-pad); right: var(--lb-pad); z-index: 2; }
  .lightbox .prev { grid-area: prev; }
  .lightbox .nextb { grid-area: next; }
  @media (max-width: 640px) {
    .lightbox { --lb-btn: 2.9rem; }
    .lightbox[open] { grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr) auto; grid-template-areas: 'stage stage' 'prev next';
      column-gap: 1rem; row-gap: .9rem; padding-top: calc(var(--lb-pad) + var(--lb-btn) + .5rem); }
    .lightbox :global(.lb-img) { max-width: calc(100vw - 2 * var(--lb-pad)); max-height: calc(100dvh - 2 * var(--lb-pad) - 2 * var(--lb-btn) - 6.5rem); }
    .lightbox figcaption { font-size: .9rem; }
    .lightbox .prev { justify-self: end; }
    .lightbox .nextb { justify-self: start; }
  }
  @keyframes lb-in { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } .lb-btn { transition: none; } }
  :global(html:has(dialog.lightbox[open])) { overflow: hidden; }
</style>
