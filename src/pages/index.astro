---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CompactCard from '../components/CompactCard.astro';
import Icon from '../components/Icon.astro';
import { site, copy, experience, education, skills } from '../data/site';
import { caseStudies, compactProjects } from '../data/projects';
import { responsive, shotSizes } from '../lib/images';

const firstPerProject = caseStudies
  .map((p) => p.screenshots[p.heroShot ?? 0])
  .filter(Boolean);
const fill = caseStudies[0]?.screenshots.slice(1, 2) ?? [];
const hero = [...firstPerProject, ...fill].slice(0, 2);
const shipped = caseStudies.filter((p) => /app store|google play/i.test(p.status)).length;
const h = copy.hero;
const w = copy.work;
const sk = copy.skills;
const ex = copy.experience;
const c = copy.contact;
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">{h.eyebrow}</p>
        <h1 class="reveal">
          {site.name}<span class="sr-break">, </span>
          <span class="line2">{h.lineBeforeSerif} <span class="serif">{h.serif}</span> <span class="serif accent">{h.serifAccent}</span></span>
        </h1>
        <p class="lede reveal">{h.lede}</p>
        <div class="actions reveal">
          <a class="btn btn-primary" href="#work">{h.primaryCta} <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="#contact">{h.secondaryCta}</a>
          {site.cvPath && <a class="btn btn-ghost" href={site.cvPath} download>{h.cvCta} <Icon name="download" /></a>}
        </div>
        <ul class="proof reveal" aria-label={h.proofAria}>
          <li><span class="k">{shipped}</span><span class="v">{shipped === 1 ? h.proof.appsLive.singular : h.proof.appsLive.plural}</span></li>
          <li><span class="k">{h.proof.ios.k}</span><span class="v">{h.proof.ios.v}</span></li>
          <li><span class="k" lang="ar">{h.proof.arabic.k}</span><span class="v">{h.proof.arabic.v}</span></li>
        </ul>
      </div>
      <div class="hero-stage" aria-hidden="true">
        {hero.map((s, i) => (
          <figure class={`shot h${i}`}><img src={s.src} srcset={responsive(s.src).srcset} sizes={shotSizes.homeHero} alt="" width="590" height="1280" fetchpriority={i === 0 ? 'high' : 'auto'} /></figure>
        ))}
        <div class="halo"></div>
      </div>
    </div>
  </section>

  <section id="work" class="section work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{w.eyebrow}</p>
        <h2 id="work-title">{w.titleBefore} <span class="serif">{w.titleSerif}</span></h2>
        <p>{w.body}</p>
      </div>
      <div class="features">
        {caseStudies.map((p, i) => <FeatureCard project={p} index={i} />)}
      </div>
      {compactProjects.length > 0 && (
        <div class="more">
          <h3 class="more-title reveal">{w.moreTitle}</h3>
          <div class="compact-grid">
            {compactProjects.map((p) => <CompactCard project={p} />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section id="skills" class="section skills" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{sk.eyebrow}</p>
        <h2 id="skills-title">{sk.titleBefore} <span class="serif">{sk.titleSerif}</span></h2>
        <p>{sk.body}</p>
      </div>
      <div class="skill-grid">
        {skills.map((g, i) => (
          <div class="skill reveal">
            <p class="idx">{String(i + 1).padStart(2, '0')}</p>
            <h3>{g.group}</h3>
            <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section experience" aria-labelledby="exp-title">
    <div class="container exp-grid">
      <div class="section-head reveal">
        <p class="eyebrow">{ex.eyebrow}</p>
        <h2 id="exp-title">{ex.titleBefore} <span class="serif">{ex.titleSerif}</span></h2>
      </div>
      <div class="timeline">
        {experience.map((e) => (
          <article class="job reveal">
            <div class="job-head">
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org} · {e.place}</p>
              </div>
              <p class="period">{e.period}</p>
            </div>
            <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
          </article>
        ))}
        <div class="edu reveal">
          <h3>{ex.educationHeading}</h3>
          <ul>
            {education.map((ed) => (
              <li><span class="t">{ed.title}</span><span class="o">{ed.org}</span><span class="p">{ed.period}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-card reveal">
        <p class="eyebrow">{c.eyebrow}</p>
        <h2 id="contact-title">{c.titleBefore} <span class="serif">{c.titleSerif}</span></h2>
        <p>{c.body}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
          <a class="btn btn-ghost" href={site.links.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> {c.linkedin}<span class="visually-hidden">{c.newTab}</span></a>
          <a class="btn btn-ghost" href={site.links.github} target="_blank" rel="me noopener"><Icon name="github" /> {c.github}<span class="visually-hidden">{c.newTab}</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2rem, 6vw, 4rem); position: relative; }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.15fr 0.85fr; } }
  .hero-copy { display: grid; gap: 1.6rem; }
  h1 { font-size: clamp(1.15rem, 2vw, 1.35rem); font-weight: 560; letter-spacing: -0.01em; color: var(--muted); display: grid; gap: 1rem; }
  .sr-break { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .line2 { font-size: clamp(2.6rem, 7.2vw, 5.4rem); color: var(--text); font-weight: 650; letter-spacing: -0.035em; line-height: 1.0; }
  .line2 .serif { font-size: 1.04em; }
  .accent { background: linear-gradient(90deg, var(--accent), #9aa6ff); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.08em; }
  .lede { font-size: clamp(1.08rem, 1.6vw, 1.25rem); color: var(--muted); max-width: 38rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .proof { list-style: none; margin: 0.5rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid var(--line); display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); }
  .proof li { display: grid; gap: 0.2rem; }
  .proof .k { font-size: 1.6rem; font-weight: 650; letter-spacing: -0.02em; color: var(--text); }
  .proof .v { font-size: 0.88rem; color: var(--faint); line-height: 1.4; }

  .hero-stage { position: relative; height: clamp(26rem, 60vw, 36rem); }
  .hero-stage .shot { position: absolute; margin: 0; width: clamp(10rem, 24vw, 15rem); top: 50%; left: 50%; }
  .h0 { transform: translate(-80%, -54%) rotate(-5deg); z-index: 2; }
  .h1 { transform: translate(-12%, -44%) rotate(4deg); z-index: 3; }
  .halo { position: absolute; inset: 15% 10%; background: radial-gradient(closest-side, rgba(92,200,255,.25), transparent); filter: blur(30px); z-index: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .h0 { animation: float 9s ease-in-out infinite; }
    .h1 { animation: float2 10s ease-in-out infinite; }
    @keyframes float { 50% { transform: translate(-80%, -57%) rotate(-6deg); } }
    @keyframes float2 { 50% { transform: translate(-12%, -41%) rotate(5deg); } }
  }
  /* Mobile & tablet: copy first (DOM order), phones below and smaller, tighter rhythm so both CTAs sit above the fold. */
  @media (max-width: 959px) {
    .hero { padding-block: 2rem clamp(2rem, 6vw, 4rem); }
    .hero-grid { gap: 1.5rem; }
    .hero-copy { gap: 1.25rem; }
    h1 { gap: 0.75rem; }
    .line2 { text-wrap: balance; }
    .proof { margin-top: 0.25rem; }
    .hero-stage { height: 17rem; }
    .hero-stage .shot { width: 7.5rem; }
  }
  @media (max-width: 600px) {
    .proof { padding-top: 1.1rem; gap: 0.85rem; grid-template-columns: 1fr; }
    .proof li { grid-template-columns: 2.75rem 1fr; align-items: center; gap: 0.9rem; }
    .proof .k { font-size: 1.4rem; line-height: 1.1; }
  }
  @media (max-width: 480px) {
    .hero .actions .btn { flex: 1 1 auto; justify-content: center; }
    .hero-stage { height: 14rem; }
    .hero-stage .shot { width: 6.25rem; }
  }

  .features { display: grid; gap: clamp(1.25rem, 3vw, 2rem); }
  .more { margin-top: clamp(3rem, 7vw, 5rem); }
  .more-title { font-size: 1.1rem; font-family: var(--font-mono); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); margin-bottom: 1.25rem; }
  .compact-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }

  .skill-grid { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .skill { background: var(--bg-2); padding: 1.75rem; display: grid; gap: 0.9rem; align-content: start; }
  .idx { font-family: var(--font-mono); font-size: .78rem; color: var(--accent-2); }
  .skill h3 { font-size: 1.3rem; }
  .skill ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; color: var(--muted); }
  .skill li { padding-left: 1rem; position: relative; }
  .skill li::before { content: ''; position: absolute; left: 0; top: .7em; width: .35rem; height: 1px; background: var(--accent); }

  .exp-grid { display: grid; gap: 2rem; }
  @media (min-width: 960px) { .exp-grid { grid-template-columns: 0.8fr 1.2fr; align-items: start; } .exp-grid .section-head { position: sticky; top: 6rem; } }
  .timeline { display: grid; gap: 1.25rem; }
  .job, .edu { padding: 1.75rem; border-radius: var(--radius); background: linear-gradient(180deg, var(--surface), var(--bg-2)); border: 1px solid var(--line); }
  .job-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; margin-bottom: 1.1rem; }
  .job h3, .edu h3 { font-size: 1.35rem; }
  .org { color: var(--muted); margin-top: .3rem; }
  .period { font-family: var(--font-mono); font-size: .82rem; color: var(--accent-2); white-space: nowrap; }
  .job ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .55rem; color: var(--muted); }
  .job li::marker { color: var(--accent); }
  .edu ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; }
  .edu li { display: grid; grid-template-columns: 1fr auto; gap: .1rem 1rem; padding: .8rem 0; border-top: 1px solid var(--line); }
  .edu .t { font-weight: 560; }
  .edu .o { grid-column: 1; color: var(--faint); font-size: .92rem; }
  .edu .p { grid-row: 1; grid-column: 2; font-family: var(--font-mono); font-size: .82rem; color: var(--faint); }

  .contact-card {
    text-align: center; display: grid; justify-items: center; gap: 1.25rem; padding: clamp(2.5rem, 7vw, 5rem) clamp(1.25rem, 4vw, 3rem);
    border-radius: calc(var(--radius) + 8px); border: 1px solid var(--line-strong);
    background: radial-gradient(40rem 20rem at 50% 0%, rgba(92,200,255,.16), transparent 70%), linear-gradient(180deg, var(--surface), var(--bg-2));
  }
  .contact-card h2 { font-size: clamp(2rem, 5vw, 3.6rem); max-width: 18ch; }
  .contact-card p { color: var(--muted); max-width: 34rem; }
  .contact-card .actions { justify-content: center; }
  .contact-card .btn-primary { word-break: break-all; }
</style>
